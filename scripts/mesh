#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ENV_FILE="${MESH_ENV_FILE:-$HOME/.mesh/.env.mesh}"
FALLBACK_EXPORTS="${HOME}/.mesh/router.env"
WS_REPO_BASE="${MESH_WS_REPO_BASE:-/media/sam/1TB}"
PIPELINE_TEMPLATE="${MESH_PIPELINE_TEMPLATE:-speckit}"
MESH_UI_FORWARD_HOST="${MESH_UI_FORWARD_HOST-sam@10.0.0.5}"
MESH_UI_FORWARD_REPO="${MESH_UI_FORWARD_REPO-/Users/sam/gobabygo}"
MESH_ENV_SOURCES=(
  "/etc/mesh-worker/common.env"
  "/etc/mesh-worker/mesh-session-claude-work.env"
  "/etc/mesh-worker/mesh-session-codex-work.env"
  "/etc/mesh-worker/mesh-worker-claude-work.env"
  "/etc/mesh-worker/mesh-worker-codex-work.env"
  "/etc/mesh-worker/mesh-worker-gemini-work.env"
  "${FALLBACK_EXPORTS}"
  "${ENV_FILE}"
)

is_local_host() {
  local host="$1"
  local target target_ip
  target="${host#*@}"
  target="${target%%:*}"

  case "$target" in
    localhost|127.0.0.1)
      return 0
      ;;
  esac

  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    local ssh_server_ip
    ssh_server_ip="$(awk '{print $3}' <<<"${SSH_CONNECTION}" 2>/dev/null || true)"
    if [[ -n "$ssh_server_ip" && "$target" == "$ssh_server_ip" ]]; then
      return 0
    fi
  fi

  [[ "$target" == "$(hostname 2>/dev/null || true)" ]] && return 0

  target_ip=""
  if command -v getent >/dev/null 2>&1; then
    target_ip="$(getent ahostsv4 "$target" 2>/dev/null | awk 'NR==1{print $1}')"
  fi
  [[ -z "$target_ip" ]] && target_ip="$target"
  if command -v ip >/dev/null 2>&1 && ip -4 addr show 2>/dev/null | grep -qw "$target_ip"; then
    return 0
  fi
  return 1
}

detect_python() {
  if command -v python3 >/dev/null 2>&1; then
    echo "python3"
    return 0
  fi
  if command -v python >/dev/null 2>&1; then
    echo "python"
    return 0
  fi
  echo "Error: python3/python not found in PATH" >&2
  return 127
}

python_has_module() {
  local py_bin="$1"
  local module="$2"
  "$py_bin" -c "import ${module}" >/dev/null 2>&1
}

detect_uv() {
  if command -v uv >/dev/null 2>&1; then
    command -v uv
    return 0
  fi
  if [[ -x "$HOME/.local/bin/uv" ]]; then
    echo "$HOME/.local/bin/uv"
    return 0
  fi
  return 1
}

router_url_scheme() {
  local url="$1"
  if [[ "$url" == *"://"* ]]; then
    printf '%s\n' "${url%%://*}"
    return 0
  fi
  printf 'http\n'
}

router_url_host() {
  local url="$1"
  url="${url#*://}"
  url="${url%%/*}"
  printf '%s\n' "${url%%:*}"
}

router_url_port() {
  local url="$1"
  local scheme hostport port
  scheme="$(router_url_scheme "$url")"
  url="${url#*://}"
  hostport="${url%%/*}"
  if [[ "$hostport" == *:* ]]; then
    port="${hostport##*:}"
    printf '%s\n' "$port"
    return 0
  fi
  if [[ "$scheme" == "https" ]]; then
    printf '443\n'
  else
    printf '80\n'
  fi
}

ensure_mac_router_tunnel() {
  [[ "$(uname -s)" == "Darwin" ]] || return 0
  [[ "${MESH_MAC_ROUTER_TUNNEL:-1}" != "0" ]] || return 0
  [[ -n "${MESH_ROUTER_URL:-}" ]] || return 0

  local scheme host port local_port ws_host
  scheme="$(router_url_scheme "$MESH_ROUTER_URL")"
  host="$(router_url_host "$MESH_ROUTER_URL")"
  port="$(router_url_port "$MESH_ROUTER_URL")"
  if [[ -z "$host" || "$host" == "127.0.0.1" || "$host" == "localhost" ]]; then
    return 0
  fi

  local_port="${MESH_ROUTER_LOCAL_PORT:-8782}"
  ws_host="${MESH_WS_HOST:-sam@10.0.0.2}"
  if ! lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then
    ssh -f -N -L "${local_port}:${host}:${port}" "$ws_host"
  fi
  export MESH_ROUTER_URL="${scheme}://127.0.0.1:${local_port}"
}

run_with_optional_questionary() {
  local py_bin="$1"
  local script="$2"
  shift 2
  "$py_bin" "$script" "$@"
}

exec_attach_from_payload() {
  local py_bin="$1"
  local selection_json="$2"

  selection_env="$(MESH_SELECTION_JSON="$selection_json" "$py_bin" - <<'PY'
import json
import shlex
import os

payload = json.loads(os.environ["MESH_SELECTION_JSON"])
selection = payload.get("selection") or {}
attach = payload.get("attach") or {}
values = {
    "MESH_ATTACH_MODE": attach.get("mode", ""),
    "MESH_ATTACH_SSH_TARGET": attach.get("ssh_target", ""),
    "MESH_ATTACH_SSH_PORT": attach.get("ssh_port", ""),
    "MESH_ATTACH_REMOTE_CMD": attach.get("remote_cmd", ""),
    "MESH_ATTACH_SESSION_ID": selection.get("session_id", ""),
    "MESH_ATTACH_REPO": selection.get("repo", ""),
    "MESH_ATTACH_ROLE": selection.get("role", ""),
    "MESH_ATTACH_CLI": selection.get("cli_type", ""),
}
for key, value in values.items():
    print(f"{key}={shlex.quote(str(value or ''))}")
PY
)" || exit $?
  eval "$selection_env"

  if [[ "${MESH_ATTACH_MODE:-}" == "unavailable" || -z "${MESH_ATTACH_MODE:-}" ]]; then
    echo "Error: selected session has no attach handle or tmux session metadata." >&2
    exit 1
  fi

  echo "[mesh attach] session=${MESH_ATTACH_SESSION_ID:0:12} repo=${MESH_ATTACH_REPO:-?} role=${MESH_ATTACH_ROLE:-?} cli=${MESH_ATTACH_CLI:-?}"

  ssh_port_args=()
  if [[ -n "${MESH_ATTACH_SSH_PORT:-}" && "${MESH_ATTACH_SSH_PORT:-}" != "22" ]]; then
    ssh_port_args=(-p "$MESH_ATTACH_SSH_PORT")
  fi

  case "${MESH_ATTACH_MODE}" in
    upterm)
      exec ssh -tt "${ssh_port_args[@]}" "$MESH_ATTACH_SSH_TARGET"
      ;;
    ssh_tmux|ws_tmux)
      if is_local_host "$MESH_ATTACH_SSH_TARGET"; then
        exec bash -lc "$MESH_ATTACH_REMOTE_CMD"
      fi
      exec ssh -tt "${ssh_port_args[@]}" "$MESH_ATTACH_SSH_TARGET" "bash -lc $(printf '%q' "$MESH_ATTACH_REMOTE_CMD")"
      ;;
    *)
      echo "Error: unsupported attach mode '${MESH_ATTACH_MODE}'" >&2
      exit 1
      ;;
  esac
}

emit_manage_report() {
  local py_bin="$1"
  local manage_json="$2"

  MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
import sys

payload = json.loads(os.environ["MESH_MANAGE_JSON"])
action = str(payload.get("action") or "").strip()
selection = payload.get("selection") or {}
result = payload.get("result") or {}
target_kind = str(selection.get("target_kind") or "session").strip()

repo = selection.get("repo_name") or selection.get("repo") or "?"
session_id = str(selection.get("session_id") or "")[:12]
role = selection.get("role") or "-"
cli = selection.get("cli_type") or "-"
ui_group = selection.get("ui_group_id") or "-"
thread = selection.get("thread_name") or "-"

if action == "kill":
    if target_kind == "layout":
        print(f"[mesh kill layout] repo={repo} ui_group={ui_group} thread={thread}")
    else:
        print(
            f"[mesh kill panel] session={session_id} repo={repo} role={role} "
            f"cli={cli} state={result.get('state') or '?'} ui_group={ui_group} thread={thread}"
        )
        for item in result.get("failures") or []:
            print(f"  - {item}", file=sys.stderr)
elif action == "attach":
    if target_kind == "layout":
        print(f"[mesh ui attach] repo={repo} ui_group={ui_group} via=session-picker")
    else:
        print(f"[mesh attach panel] session={session_id} repo={repo} role={role} cli={cli}")
elif action == "quit":
    if target_kind == "layout":
        print(f"[mesh sessions] cancelled repo={repo} target=layout ui_group={ui_group}")
    else:
        print(f"[mesh sessions] cancelled repo={repo} target=panel role={role} session={session_id}")
PY
}

run_session_manage_flow() {
  local py_bin="$1"
  local forced_action="${2:-}"
  shift 2

  local manage_script manage_output manage_json action manage_rc
  local -a manage_args

  manage_script="${REPO_ROOT}/scripts/mesh_session_manage.py"
  if [[ ! -f "$manage_script" ]]; then
    echo "Error: missing session manage script at $manage_script" >&2
    exit 1
  fi

  manage_output="$(mktemp "${TMPDIR:-/tmp}/mesh-manage.XXXXXX.json")"
  trap 'rm -f "${manage_output:-}"' EXIT
  manage_args=()
  if [[ -n "$forced_action" ]]; then
    manage_args+=(--action "$forced_action")
  fi
  manage_args+=("$@")

  set +e
  run_with_optional_questionary "$py_bin" "$manage_script" "${manage_args[@]}" --output "$manage_output"
  manage_rc=$?
  set -e

  if [[ ! -s "$manage_output" ]]; then
    rm -f "$manage_output"
    trap - EXIT
    exit "$manage_rc"
  fi

  manage_json="$(cat "$manage_output")" || exit $?
  rm -f "$manage_output"
  trap - EXIT

  action="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
print(str(payload.get("action") or "").strip())
PY
)" || exit $?

  case "$action" in
    attach)
      target_kind="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
selection = payload.get("selection") or {}
print(str(selection.get("target_kind") or "session").strip())
PY
)" || exit $?
      if [[ "$target_kind" == "layout" ]]; then
        emit_manage_report "$py_bin" "$manage_json"
        repo_target="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
selection = payload.get("selection") or {}
repo = str(selection.get("repo") or "").strip()
repo_name = str(selection.get("repo_name") or "").strip()
print(repo or repo_name)
PY
)" || exit $?
        if [[ -z "$repo_target" ]]; then
          echo "Error: selected session has no repo target for layout attach" >&2
          exit 1
        fi
        exec "$0" ui attach "$repo_target"
      fi
      exec_attach_from_payload "$py_bin" "$manage_json"
      ;;
    kill)
      target_kind="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
selection = payload.get("selection") or {}
print(str(selection.get("target_kind") or "session").strip())
PY
)" || exit $?
      emit_manage_report "$py_bin" "$manage_json"
      if [[ "$target_kind" == "layout" ]]; then
        repo_target="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
selection = payload.get("selection") or {}
repo = str(selection.get("repo") or "").strip()
repo_name = str(selection.get("repo_name") or "").strip()
print(repo or repo_name)
PY
)" || exit $?
        ui_group_target="$(MESH_MANAGE_JSON="$manage_json" "$py_bin" - <<'PY'
import json
import os
payload = json.loads(os.environ["MESH_MANAGE_JSON"])
selection = payload.get("selection") or {}
print(str(selection.get("ui_group_id") or "").strip())
PY
)" || exit $?
        if [[ -z "$repo_target" || -z "$ui_group_target" ]]; then
          echo "Error: selected layout has incomplete repo/ui_group metadata" >&2
          exit 1
        fi
        exec "$0" ui close "$repo_target" --ui-group-id "$ui_group_target"
      fi
      exit "$manage_rc"
      ;;
    ""|quit)
      emit_manage_report "$py_bin" "$manage_json"
      exit 0
      ;;
    *)
      echo "Error: unsupported manage action '$action'" >&2
      exit 1
      ;;
  esac
}

run_meshctl() {
  ensure_router_env
  ensure_mac_router_tunnel

  local use_dotenvx=0
  if [[ -z "${MESH_ROUTER_URL:-}" || -z "${MESH_AUTH_TOKEN:-}" ]]; then
    use_dotenvx=1
  fi

  # Prefer uv-managed environment when available.
  if command -v uv >/dev/null 2>&1 && [[ -f "$REPO_ROOT/pyproject.toml" ]]; then
    if [[ "$use_dotenvx" == "1" ]] && command -v dotenvx >/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
      (cd "$REPO_ROOT" && dotenvx run -f "$ENV_FILE" -- uv run -- python -m src.meshctl "$@")
    else
      (cd "$REPO_ROOT" && uv run -- python -m src.meshctl "$@")
    fi
    return $?
  fi

  py_bin="$(detect_python)" || exit $?
  if [[ "$use_dotenvx" == "1" ]] && command -v dotenvx >/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
    (cd "$REPO_ROOT" && dotenvx run -f "$ENV_FILE" -- "$py_bin" -m src.meshctl "$@")
  else
    (cd "$REPO_ROOT" && "$py_bin" -m src.meshctl "$@")
  fi
  return $?
}

extract_kv() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 1
  awk -F= -v key="$key" '
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?"key"=" {
      line = $0
      sub(/^[[:space:]]*(export[[:space:]]+)?/, "", line)
      sub(/^[^=]*=/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      gsub(/^["'"'"']|["'"'"']$/, "", line)
      print line
      exit 0
    }
  ' "$file"
}

persist_router_env_if_possible() {
  [[ -n "${MESH_ROUTER_URL:-}" ]] || return 0
  [[ -n "${MESH_AUTH_TOKEN:-}" ]] || return 0

  mkdir -p "$(dirname "$FALLBACK_EXPORTS")" 2>/dev/null || return 0
  touch "$FALLBACK_EXPORTS" 2>/dev/null || return 0
  cat >"$FALLBACK_EXPORTS" <<EOF
export MESH_ROUTER_URL=${MESH_ROUTER_URL}
export MESH_AUTH_TOKEN=${MESH_AUTH_TOKEN}
EOF
}

ensure_router_env() {
  # Keep explicit shell env as highest priority.
  if [[ -n "${MESH_ROUTER_URL:-}" && -n "${MESH_AUTH_TOKEN:-}" ]]; then
    return 0
  fi

  local src router token

  # Discover values from known env files.
  for src in "${MESH_ENV_SOURCES[@]}"; do
    [[ -r "$src" ]] || continue

    if [[ -z "${MESH_ROUTER_URL:-}" ]]; then
      router="$(extract_kv "$src" "MESH_ROUTER_URL" || true)"
      [[ -n "$router" ]] && export MESH_ROUTER_URL="$router"
    fi

    if [[ -z "${MESH_AUTH_TOKEN:-}" ]]; then
      token="$(extract_kv "$src" "MESH_AUTH_TOKEN" || true)"
      [[ -n "$token" ]] && export MESH_AUTH_TOKEN="$token"
    fi

    if [[ -n "${MESH_ROUTER_URL:-}" && -n "${MESH_AUTH_TOKEN:-}" ]]; then
      break
    fi
  done

  # WS-friendly default router address if nothing discovered.
  if [[ -z "${MESH_ROUTER_URL:-}" && -d "/etc/mesh-worker" ]]; then
    export MESH_ROUTER_URL="http://192.168.1.100:8780"
  fi

  persist_router_env_if_possible
}

