lite_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh lite probe --project <repo-path>
  ./scripts/mesh lite discover --project <repo-path>
  ./scripts/mesh lite status [--project <repo-path>]
  ./scripts/mesh lite relay-last --project <repo-path> <source-role> <target-role> [--dry-run]

Behavior:
  mesh lite is the iTerm2-first manual control path built on the validated attached bridge spike.
  It keeps a small local registry and does not talk to the router.
EOF
}

live_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh live board [query] [--lines N] [--json]
  ./scripts/mesh live peek <session> [lines] [--owner <user>] [--json]

Behavior:
  mesh live reads tmux directly on the configured workstation.
  It does not require the router or iTerm2 and is read-only in this release.

Env:
  MESH_WS_HOST       SSH target hosting tmux (default: sam@10.0.0.2)
  MESH_LIVE_USERS    comma-separated tmux owners to inspect
  MESH_LIVE_LOCAL    set to 1 to inspect tmux on this machine

Examples:
  ./scripts/mesh live board
  ./scripts/mesh live board rektslug --lines 40
  ./scripts/mesh live peek claude-rektslug 120
  ./scripts/mesh live --host dell-vpn board --lines 0
EOF
}

session_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh sessions [--list] [--all] [repo|session|role]
  ./scripts/mesh session list [--all] [repo|session|role]

Behavior:
  TTY default      hierarchical picker: Layout -> Panels
  --list           raw router-backed list only
  --all            search across repos

Compatibility aliases:
  ./scripts/mesh session manage [--all] [repo|session|role]
  ./scripts/mesh attach [repo|session|role]
EOF
}

ui_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh ui <repo-name|repo-path>
  ./scripts/mesh ui attach <repo-name|repo-path>
  ./scripts/mesh ui close <repo-name|repo-path>

Behavior:
  mesh ui <repo>         open the operator layout for the target repo
  mesh ui attach <repo>  reattach the existing layout for that repo
  mesh ui close <repo>   close the existing layout/backend group for that repo

Compatibility aliases:
  ./scripts/mesh ui resume <repo-name|repo-path>
EOF
}

term_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh term list [--repo <repo-path>] [--output <file>]
  ./scripts/mesh term focus <repo-path> <role>
  ./scripts/mesh term send <repo-path> <role> <text>
  ./scripts/mesh term exec <repo-path> <role> <text>
  ./scripts/mesh term key <repo-path> <role> <key>
  ./scripts/mesh term dump <repo-path> <role> [--lines N] [--output <file>]
  ./scripts/mesh term close <repo-path>
  ./scripts/mesh term two-cli-smoke <repo-path> [--response-timeout N]
  ./scripts/mesh term two-cli-e2e <repo-path> [--keep-open]
  ./scripts/mesh term team-e2e <repo-path> [--keep-open]
  ./scripts/mesh term speckit-team-e2e <repo-path> [--feature text] [--keep-open]
  ./scripts/mesh term speckit-team-run <repo-path> --feature text [--allow-write] [--auto-approve-prompts] [--no-handoff]

Behavior:
  mesh term is a thin iTerm2 control helper for mesh-marked panes.
  It targets panes by exact repo path + role and does not talk to the router.

Examples:
  ./scripts/mesh term list --repo /media/sam/1TB/snake-game
  ./scripts/mesh term focus /media/sam/1TB/snake-game boss
  ./scripts/mesh term send /media/sam/1TB/snake-game boss "status?"
  ./scripts/mesh term exec /media/sam/1TB/snake-game boss "/GBG status?"
  ./scripts/mesh term key /media/sam/1TB/snake-game boss enter
  ./scripts/mesh term dump /media/sam/1TB/snake-game president --lines 30
  ./scripts/mesh term close /media/sam/1TB/snake-game
EOF
}

speckit_usage() {
  cat <<'EOF'
Usage:
  ./scripts/mesh speckit run <repo-path> --feature text [--task text] [--auto]
  ./scripts/mesh speckit smoke <repo-path> [--team name] [--print-command]

Options:
  --auto                         Use KISS local defaults: --write, auto-approve known prompts, max-turns=1.
  --write, --allow-write         Allow the worker to edit files. No commit is made.
  --team local-codex-gemini      Use Codex boss, Codex president, Gemini worker. Default.
  --team local-gemini            Use Gemini for all roles; useful for cheaper live tests.
  --team claude-codex-gemini     Use Claude boss, Codex president, Gemini worker.
  --team env                     Defer CLI commands to MESH_TEAM_* env vars / controller defaults.
  --test-command <cmd>           Test command to run after worker returns. Defaults to ./test.sh if executable.
  --no-test                      Do not run a test command.
  --allow-test-failure           Do not fail the run when the test command fails.
  --quality off|quick            Write deterministic quality evidence. Default: off.
  --product-quality              Require reviewer PRODUCT_REVIEW score gate.
  --min-product-score N          Minimum product score. Default: 7.
  --max-quality-retries N        Maximum worker retries for product quality. Default: 0.
  --allow-edit <path>            With auto-approval, approve edit prompts only for this repo-relative path. Repeatable.
  --claude-config <path>         claude-config root for command/gate policy metadata.
  --boss-contract <name>         claude-config contract name to reserve for boss prompts.
  --president-contract <name>    claude-config contract name to reserve for president prompts.
  --worker-contract <name>       claude-config contract name to reserve for worker prompts.
  --reviewer-contract <name>     claude-config contract name to reserve for reviewer prompts.
  --with-reviewer, --reviewer    Add a reviewer AI role before the final boss report.
  --print-command                Print the expanded controller command without running it.

Behavior:
  This is a short wrapper around:
    ./scripts/mesh term speckit-team-run <repo> ...
  The smoke variant uses the validated local regression defaults:
    --allow-write --auto-approve-prompts --allow-dirty --max-turns 1 --no-handoff
EOF
}

run_speckit_short() {
  local subcmd="${1:-}"
  if [[ "$subcmd" == "" || "$subcmd" == "-h" || "$subcmd" == "--help" ]]; then
    speckit_usage
    exit 0
  fi
  if [[ "$subcmd" != "run" ]]; then
    if [[ "$subcmd" == "smoke" ]]; then
      shift
      if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        speckit_usage
        exit 0
      fi

      local repo="" team="${MESH_SPECKIT_TEAM:-local-codex-gemini}"
      local feature="${MESH_SPECKIT_SMOKE_FEATURE:-speckit-controller-smoke}"
      local task="${MESH_SPECKIT_SMOKE_TASK:-Verify local speckit team startup and fallback handling.}"
      local boss_cmd="" president_cmd="" worker_cmd="" reviewer_cmd=""
      local claude_config="" boss_contract="" president_contract="" worker_contract="" reviewer_contract=""
      local print_command=0
      local passthrough=()

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --team)
            [[ $# -ge 2 ]] || { echo "Error: --team requires a value" >&2; exit 2; }
            team="$2"
            shift 2
            ;;
          --team=*)
            team="${1#*=}"
            shift
            ;;
          --feature)
            [[ $# -ge 2 ]] || { echo "Error: --feature requires a value" >&2; exit 2; }
            feature="$2"
            shift 2
            ;;
          --feature=*)
            feature="${1#*=}"
            shift
            ;;
          --task)
            [[ $# -ge 2 ]] || { echo "Error: --task requires a value" >&2; exit 2; }
            task="$2"
            shift 2
            ;;
          --task=*)
            task="${1#*=}"
            shift
            ;;
          --boss-cmd)
            [[ $# -ge 2 ]] || { echo "Error: --boss-cmd requires a value" >&2; exit 2; }
            boss_cmd="$2"
            shift 2
            ;;
          --president-cmd)
            [[ $# -ge 2 ]] || { echo "Error: --president-cmd requires a value" >&2; exit 2; }
            president_cmd="$2"
            shift 2
            ;;
          --worker-cmd)
            [[ $# -ge 2 ]] || { echo "Error: --worker-cmd requires a value" >&2; exit 2; }
            worker_cmd="$2"
            shift 2
            ;;
          --reviewer-cmd)
            [[ $# -ge 2 ]] || { echo "Error: --reviewer-cmd requires a value" >&2; exit 2; }
            reviewer_cmd="$2"
            shift 2
            ;;
          --claude-config)
            [[ $# -ge 2 ]] || { echo "Error: --claude-config requires a value" >&2; exit 2; }
            claude_config="$2"
            shift 2
            ;;
          --claude-config=*)
            claude_config="${1#*=}"
            shift
            ;;
          --boss-contract)
            [[ $# -ge 2 ]] || { echo "Error: --boss-contract requires a value" >&2; exit 2; }
            boss_contract="$2"
            shift 2
            ;;
          --boss-contract=*)
            boss_contract="${1#*=}"
            shift
            ;;
          --president-contract)
            [[ $# -ge 2 ]] || { echo "Error: --president-contract requires a value" >&2; exit 2; }
            president_contract="$2"
            shift 2
            ;;
          --president-contract=*)
            president_contract="${1#*=}"
            shift
            ;;
          --worker-contract)
            [[ $# -ge 2 ]] || { echo "Error: --worker-contract requires a value" >&2; exit 2; }
            worker_contract="$2"
            shift 2
            ;;
          --worker-contract=*)
            worker_contract="${1#*=}"
            shift
            ;;
          --reviewer-contract)
            [[ $# -ge 2 ]] || { echo "Error: --reviewer-contract requires a value" >&2; exit 2; }
            reviewer_contract="$2"
            shift 2
            ;;
          --reviewer-contract=*)
            reviewer_contract="${1#*=}"
            shift
            ;;
          --print-command)
            print_command=1
            shift
            ;;
          --)
            shift
            passthrough+=("$@")
            break
            ;;
          -*)
            passthrough+=("$1")
            shift
            ;;
          *)
            if [[ -z "$repo" ]]; then
              repo="$1"
            else
              passthrough+=("$1")
            fi
            shift
            ;;
        esac
      done

      if [[ -z "$repo" ]]; then
        echo "Error: missing repo path" >&2
        speckit_usage
        exit 2
      fi

      resolve_repo_path_and_name "$repo"
      local repo_path="$RESOLVED_REPO_PATH"

      case "$team" in
        local-codex-gemini)
          boss_cmd="${boss_cmd:-codex}"
          president_cmd="${president_cmd:-codex}"
          worker_cmd="${worker_cmd:-gemini}"
          reviewer_cmd="${reviewer_cmd:-gemini}"
          ;;
        local-gemini|gemini)
          boss_cmd="${boss_cmd:-gemini}"
          president_cmd="${president_cmd:-gemini}"
          worker_cmd="${worker_cmd:-gemini}"
          reviewer_cmd="${reviewer_cmd:-gemini}"
          ;;
        claude-codex-gemini)
          boss_cmd="${boss_cmd:-claude}"
          president_cmd="${president_cmd:-codex}"
          worker_cmd="${worker_cmd:-gemini}"
          reviewer_cmd="${reviewer_cmd:-gemini}"
          ;;
        env)
          ;;
        *)
          echo "Error: unsupported speckit team '$team'" >&2
          speckit_usage
          exit 2
          ;;
      esac

      local args=(speckit-team-run --repo "$repo_path" --feature "$feature" --task "$task" --max-turns 1 --allow-write --auto-approve-prompts --allow-dirty)
      [[ -n "$boss_cmd" ]] && args+=(--boss-cmd "$boss_cmd")
      [[ -n "$president_cmd" ]] && args+=(--president-cmd "$president_cmd")
      [[ -n "$worker_cmd" ]] && args+=(--worker-cmd "$worker_cmd")
      [[ -n "$reviewer_cmd" ]] && args+=(--reviewer-cmd "$reviewer_cmd")
      [[ -n "$claude_config" ]] && args+=(--claude-config "$claude_config")
      [[ -n "$boss_contract" ]] && args+=(--boss-contract "$boss_contract")
      [[ -n "$president_contract" ]] && args+=(--president-contract "$president_contract")
      [[ -n "$worker_contract" ]] && args+=(--worker-contract "$worker_contract")
      [[ -n "$reviewer_contract" ]] && args+=(--reviewer-contract "$reviewer_contract")
      args+=(--no-handoff)
      args+=("${passthrough[@]}")

      if [[ "$print_command" -eq 1 ]]; then
        printf 'python scripts/mesh_iterm_control.py'
        printf ' %q' "${args[@]}"
        printf '\n'
        exit 0
      fi

      run_iterm_control "${args[@]}"
      exit $?
    fi
    echo "Error: unsupported speckit subcommand '$subcmd'" >&2
    speckit_usage
    exit 2
  fi
  shift
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    speckit_usage
    exit 0
  fi

  local repo="" feature="" task="" team="${MESH_SPECKIT_TEAM:-local-codex-gemini}"
  local boss_cmd="" president_cmd="" worker_cmd="" reviewer_cmd=""
  local claude_config="" boss_contract="" president_contract="" worker_contract="" reviewer_contract=""
  local allow_write=0 auto_mode=0 auto_approve=0 print_command=0
  local with_reviewer=0
  local test_command="" test_command_set=0 max_turns="${MESH_SPECKIT_MAX_TURNS:-1}" quality="${MESH_SPECKIT_QUALITY:-off}"
  local product_quality=0 min_product_score="${MESH_MIN_PRODUCT_SCORE:-7}" max_quality_retries="${MESH_MAX_QUALITY_RETRIES:-0}"
  local passthrough=() allow_edits=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --feature)
        [[ $# -ge 2 ]] || { echo "Error: --feature requires a value" >&2; exit 2; }
        feature="$2"
        shift 2
        ;;
      --feature=*)
        feature="${1#*=}"
        shift
        ;;
      --task)
        [[ $# -ge 2 ]] || { echo "Error: --task requires a value" >&2; exit 2; }
        task="$2"
        shift 2
        ;;
      --task=*)
        task="${1#*=}"
        shift
        ;;
      --team)
        [[ $# -ge 2 ]] || { echo "Error: --team requires a value" >&2; exit 2; }
        team="$2"
        shift 2
        ;;
      --team=*)
        team="${1#*=}"
        shift
        ;;
      --boss-cmd)
        [[ $# -ge 2 ]] || { echo "Error: --boss-cmd requires a value" >&2; exit 2; }
        boss_cmd="$2"
        shift 2
        ;;
      --president-cmd)
        [[ $# -ge 2 ]] || { echo "Error: --president-cmd requires a value" >&2; exit 2; }
        president_cmd="$2"
        shift 2
        ;;
      --worker-cmd)
        [[ $# -ge 2 ]] || { echo "Error: --worker-cmd requires a value" >&2; exit 2; }
        worker_cmd="$2"
        shift 2
        ;;
      --reviewer-cmd)
        [[ $# -ge 2 ]] || { echo "Error: --reviewer-cmd requires a value" >&2; exit 2; }
        reviewer_cmd="$2"
        shift 2
        ;;
      --claude-config)
        [[ $# -ge 2 ]] || { echo "Error: --claude-config requires a value" >&2; exit 2; }
        claude_config="$2"
        shift 2
        ;;
      --claude-config=*)
        claude_config="${1#*=}"
        shift
        ;;
      --boss-contract)
        [[ $# -ge 2 ]] || { echo "Error: --boss-contract requires a value" >&2; exit 2; }
        boss_contract="$2"
        shift 2
        ;;
      --boss-contract=*)
        boss_contract="${1#*=}"
        shift
        ;;
      --president-contract)
        [[ $# -ge 2 ]] || { echo "Error: --president-contract requires a value" >&2; exit 2; }
        president_contract="$2"
        shift 2
        ;;
      --president-contract=*)
        president_contract="${1#*=}"
        shift
        ;;
      --worker-contract)
        [[ $# -ge 2 ]] || { echo "Error: --worker-contract requires a value" >&2; exit 2; }
        worker_contract="$2"
        shift 2
        ;;
      --worker-contract=*)
        worker_contract="${1#*=}"
        shift
        ;;
      --reviewer-contract)
        [[ $# -ge 2 ]] || { echo "Error: --reviewer-contract requires a value" >&2; exit 2; }
        reviewer_contract="$2"
        shift 2
        ;;
      --reviewer-contract=*)
        reviewer_contract="${1#*=}"
        shift
        ;;
      --with-reviewer|--reviewer)
        with_reviewer=1
        shift
        ;;
      --write|--allow-write)
        allow_write=1
        shift
        ;;
      --auto)
        auto_mode=1
        shift
        ;;
      --auto-approve-prompts)
        auto_approve=1
        shift
        ;;
      --allow-edit|--auto-approve-edit-path)
        [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 2; }
        allow_edits+=("$2")
        shift 2
        ;;
      --max-turns)
        [[ $# -ge 2 ]] || { echo "Error: --max-turns requires a value" >&2; exit 2; }
        max_turns="$2"
        shift 2
        ;;
      --test-command)
        [[ $# -ge 2 ]] || { echo "Error: --test-command requires a value" >&2; exit 2; }
        test_command="$2"
        test_command_set=1
        shift 2
        ;;
      --no-test)
        test_command=""
        test_command_set=1
        shift
        ;;
      --quality)
        [[ $# -ge 2 ]] || { echo "Error: --quality requires a value" >&2; exit 2; }
        quality="$2"
        shift 2
        ;;
      --quality=*)
        quality="${1#*=}"
        shift
        ;;
      --product-quality)
        product_quality=1
        with_reviewer=1
        shift
        ;;
      --min-product-score)
        [[ $# -ge 2 ]] || { echo "Error: --min-product-score requires a value" >&2; exit 2; }
        min_product_score="$2"
        shift 2
        ;;
      --min-product-score=*)
        min_product_score="${1#*=}"
        shift
        ;;
      --max-quality-retries)
        [[ $# -ge 2 ]] || { echo "Error: --max-quality-retries requires a value" >&2; exit 2; }
        max_quality_retries="$2"
        shift 2
        ;;
      --max-quality-retries=*)
        max_quality_retries="${1#*=}"
        shift
        ;;
      --print-command)
        print_command=1
        shift
        ;;
      --)
        shift
        passthrough+=("$@")
        break
        ;;
      -*)
        passthrough+=("$1")
        shift
        ;;
      *)
        if [[ -z "$repo" ]]; then
          repo="$1"
        else
          passthrough+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$repo" ]]; then
    echo "Error: missing repo path" >&2
    speckit_usage
    exit 2
  fi
  if [[ -z "$feature" ]]; then
    echo "Error: missing --feature text" >&2
    speckit_usage
    exit 2
  fi

  if [[ "$auto_mode" -eq 1 ]]; then
    allow_write=1
    auto_approve=1
    max_turns="${max_turns:-1}"
  fi
  if [[ "$auto_approve" -eq 1 && "$allow_write" -ne 1 ]]; then
    echo "Error: --auto-approve-prompts requires --write or --auto" >&2
    exit 2
  fi
  case "$quality" in
    off|quick)
      ;;
    *)
      echo "Error: unsupported --quality '$quality' (expected off|quick)" >&2
      exit 2
      ;;
  esac

  resolve_repo_path_and_name "$repo"
  local repo_path="$RESOLVED_REPO_PATH"
  if [[ "$test_command_set" -eq 0 && -x "$repo_path/test.sh" ]]; then
    test_command="./test.sh"
  fi

  case "$team" in
    local-codex-gemini)
      boss_cmd="${boss_cmd:-codex}"
      president_cmd="${president_cmd:-codex}"
      worker_cmd="${worker_cmd:-gemini}"
      reviewer_cmd="${reviewer_cmd:-gemini}"
      ;;
    local-gemini|gemini)
      boss_cmd="${boss_cmd:-gemini}"
      president_cmd="${president_cmd:-gemini}"
      worker_cmd="${worker_cmd:-gemini}"
      reviewer_cmd="${reviewer_cmd:-gemini}"
      ;;
    claude-codex-gemini)
      boss_cmd="${boss_cmd:-claude}"
      president_cmd="${president_cmd:-codex}"
      worker_cmd="${worker_cmd:-gemini}"
      reviewer_cmd="${reviewer_cmd:-gemini}"
      ;;
    env)
      ;;
    *)
      echo "Error: unsupported speckit team '$team'" >&2
      speckit_usage
      exit 2
      ;;
  esac

  local args=(speckit-team-run --repo "$repo_path" --feature "$feature" --max-turns "$max_turns")
  [[ -n "$task" ]] && args+=(--task "$task")
  [[ -n "$boss_cmd" ]] && args+=(--boss-cmd "$boss_cmd")
  [[ -n "$president_cmd" ]] && args+=(--president-cmd "$president_cmd")
  [[ -n "$worker_cmd" ]] && args+=(--worker-cmd "$worker_cmd")
  [[ -n "$reviewer_cmd" ]] && args+=(--reviewer-cmd "$reviewer_cmd")
  [[ -n "$claude_config" ]] && args+=(--claude-config "$claude_config")
  [[ -n "$boss_contract" ]] && args+=(--boss-contract "$boss_contract")
  [[ -n "$president_contract" ]] && args+=(--president-contract "$president_contract")
  [[ -n "$worker_contract" ]] && args+=(--worker-contract "$worker_contract")
  [[ -n "$reviewer_contract" ]] && args+=(--reviewer-contract "$reviewer_contract")
  [[ "$with_reviewer" -eq 1 ]] && args+=(--with-reviewer)
  [[ "$product_quality" -eq 1 ]] && args+=(--product-quality --min-product-score "$min_product_score" --max-quality-retries "$max_quality_retries")
  [[ "$allow_write" -eq 1 ]] && args+=(--allow-write)
  [[ "$auto_approve" -eq 1 ]] && args+=(--auto-approve-prompts)
  for edit_path in "${allow_edits[@]}"; do
    args+=(--auto-approve-edit-path "$edit_path")
  done
  [[ -n "$test_command" ]] && args+=(--test-command "$test_command")
  [[ "$quality" != "off" ]] && args+=(--quality "$quality")
  args+=("${passthrough[@]}")

  if [[ "$print_command" -eq 1 ]]; then
    printf 'python scripts/mesh_iterm_control.py'
    printf ' %q' "${args[@]}"
    printf '\n'
    exit 0
  fi

  run_iterm_control "${args[@]}"
}

run_iterm_control() {
  local py_bin ui_script uv_bin
  py_bin="$(detect_python)" || exit $?
  ui_script="${REPO_ROOT}/scripts/mesh_iterm_control.py"
  if [[ ! -f "$ui_script" ]]; then
    echo "Error: missing iTerm control script at $ui_script" >&2
    exit 1
  fi
  if ! python_has_module "$py_bin" iterm2; then
    if uv_bin="$(detect_uv)"; then
      export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
      exec "$uv_bin" run --with iterm2 -- python "$ui_script" "$@"
    fi
    echo "Error: Python package 'iterm2' not found. Install with: uv run --with iterm2 -- python scripts/mesh_iterm_control.py ..." >&2
    exit 1
  fi
  exec "$py_bin" "$ui_script" "$@"
}

run_mesh_lite() {
  local py_bin cli_script uv_bin
  py_bin="$(detect_python)" || exit $?
  cli_script="${REPO_ROOT}/scripts/mesh_lite/cli.py"
  if [[ ! -f "$cli_script" ]]; then
    echo "Error: missing mesh lite CLI at $cli_script" >&2
    exit 1
  fi
  if [[ -n "${MESH_LITE_PYTHON:-}" && -x "${MESH_LITE_PYTHON:-}" ]]; then
    exec "${MESH_LITE_PYTHON}" "$cli_script" "$@"
  fi
  case "${1:-}" in
    probe|status)
      exec "$py_bin" "$cli_script" "$@"
      ;;
  esac
  if ! python_has_module "$py_bin" iterm2; then
    if uv_bin="$(detect_uv)"; then
      export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
      exec "$uv_bin" run --with iterm2 -- python "$cli_script" "$@"
    fi
    echo "Error: Python package 'iterm2' not found for live iTerm commands." >&2
    echo "Set MESH_LITE_PYTHON=/path/to/python-with-iterm2 or use: uv run --with iterm2 -- python scripts/mesh_lite/cli.py ..." >&2
    exit 1
  fi
  exec "$py_bin" "$cli_script" "$@"
}

resolve_repo_path_and_name() {
  # Args:
  #   $1: repo input (name or path)
  # Sets globals:
  #   RESOLVED_REPO_PATH
  #   RESOLVED_REPO_NAME
  local repo_input="$1"
  local repo_path=""
  local repo_name=""

  # Existing dir (absolute or relative) => use as-is
  if [[ -d "$repo_input" ]]; then
    repo_path="$(cd "$repo_input" && pwd -P)"
    repo_name="$(basename "$repo_path")"
  # Path-like token (contains "/") => normalize under current dir
  elif [[ "$repo_input" == *"/"* ]]; then
    repo_path="$(cd "$(dirname "$repo_input")" && pwd -P)/$(basename "$repo_input")"
    repo_name="$(basename "$repo_path")"
  else
    # Pure repo name => resolve under WS_REPO_BASE (legacy behavior)
    repo_name="$repo_input"
    repo_path="${WS_REPO_BASE}/${repo_name}"
  fi

  RESOLVED_REPO_PATH="$repo_path"
  RESOLVED_REPO_NAME="$repo_name"
}

resolve_repo_hint_for_close() {
  local repo_input="$1"

  # Preserve explicit WS-style paths that do not exist on the operator host.
  if [[ "$repo_input" == *"/"* && ! -e "$repo_input" ]]; then
    RESOLVED_REPO_PATH="$repo_input"
    RESOLVED_REPO_NAME="$(basename "${repo_input%/}")"
    return 0
  fi

  resolve_repo_path_and_name "$repo_input"
}

resolve_current_repo_context() {
  local repo_root=""
  if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" && [[ -n "$repo_root" ]]; then
    CURRENT_REPO_PATH="$repo_root"
    CURRENT_REPO_NAME="$(basename "$repo_root")"
    return 0
  fi
  CURRENT_REPO_PATH="$(pwd -P)"
  CURRENT_REPO_NAME="$(basename "$CURRENT_REPO_PATH")"
}

slugify() {
  local text="${1:-}"
  text="$(printf '%s' "$text" | tr '[:upper:]' '[:lower:]')"
  text="$(printf '%s' "$text" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  if [[ -z "$text" ]]; then
    text="work"
  fi
  printf '%s' "$text"
}

gen_feature_label() {
  # Dynamic label for ad-hoc starts without explicit feature text.
  printf 'run-%s-%04d' "$(date +%Y%m%d-%H%M%S)" "$RANDOM"
}

build_pipeline_account_args() {
  local repo_name="$1"
  PIPELINE_ACCOUNT_ARGS=(
    --account-scope "${MESH_ACCOUNT_SCOPE:-config}"
  )
  if [[ -n "${MESH_ACCOUNT_CLAUDE:-}" ]]; then
    PIPELINE_ACCOUNT_ARGS+=(--account-claude "$MESH_ACCOUNT_CLAUDE")
  fi
  if [[ -n "${MESH_ACCOUNT_CODEX:-}" ]]; then
    PIPELINE_ACCOUNT_ARGS+=(--account-codex "$MESH_ACCOUNT_CODEX")
  fi
  if [[ -n "${MESH_ACCOUNT_GEMINI:-}" ]]; then
    PIPELINE_ACCOUNT_ARGS+=(--account-gemini "$MESH_ACCOUNT_GEMINI")
  fi
}

load_router_env() {
  ensure_router_env
}

latest_thread_for_repo() {
  local repo_name="${1:-}"
  local repo_path="${2:-}"
  load_router_env
  local py_bin
  py_bin="$(detect_python)" || return $?
  "$py_bin" - "$repo_name" "$repo_path" <<'PY'
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

repo_name = sys.argv[1]
repo_path = sys.argv[2]
base = os.environ.get("MESH_ROUTER_URL", "http://localhost:8780").rstrip("/")
token = os.environ.get("MESH_AUTH_TOKEN", "")
repo_targets = {repo_name}
if repo_path:
    repo_targets.add(repo_path)
    repo_targets.add(os.path.basename(repo_path.rstrip("/")))

def get_json(path: str):
    req = Request(f"{base}{path}")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    timeout = float(os.environ.get("MESH_CONTROL_PLANE_TIMEOUT_S", "60"))
    with urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))

try:
    data = get_json("/tasks?limit=500")
except HTTPError as e:
    print(f"Error: /tasks returned {e.code}", file=sys.stderr)
    sys.exit(3)
except URLError as e:
    print(f"Error: cannot connect to mesh router at {base} -- {e}", file=sys.stderr)
    sys.exit(4)

tasks = data.get("tasks", [])
matches = []
for task in tasks:
    thread_id = str(task.get("thread_id") or "").strip()
    task_repo = str(task.get("repo") or "").strip()
    if not thread_id or not task_repo:
        continue
    if task_repo in repo_targets or os.path.basename(task_repo.rstrip("/")) in repo_targets:
        matches.append(task)

matches.sort(key=lambda item: str(item.get("updated_at") or item.get("created_at") or ""), reverse=True)
seen = set()
for task in matches:
    thread_id = str(task.get("thread_id") or "").strip()
    if thread_id in seen:
        continue
    seen.add(thread_id)
    try:
        thread = get_json(f"/threads/{thread_id}")
    except Exception:
        continue
    name = str((thread or {}).get("name") or "")
    if name:
        print(name)
        sys.exit(0)

sys.exit(2)
PY
}

cmd="${1:-}"

if [[ "$cmd" == "session" ]]; then
  subcmd="${2:-}"
  case "$subcmd" in
    list|"")
      set -- sessions "${@:3}"
      cmd="sessions"
      ;;
    manage)
      set -- sessions "${@:3}"
      cmd="sessions"
      ;;
    resolve|send|enter|interrupt|summary|close)
      py_bin="$(detect_python)" || exit $?
      ensure_router_env
      ensure_mac_router_tunnel
      session_script="${REPO_ROOT}/scripts/mesh_session_cli.py"
      if [[ ! -f "$session_script" ]]; then
        echo "Error: missing session CLI script at $session_script" >&2
        exit 1
      fi
      exec "$py_bin" "$session_script" "$subcmd" "${@:3}"
      ;;
    *)
      echo "Error: unsupported session subcommand '$subcmd'" >&2
      echo "Use: ./scripts/mesh session list [--all] [query]" >&2
      echo "Or:  ./scripts/mesh sessions [--list] [--all] [query]" >&2
      exit 2
      ;;
  esac
fi

case "$cmd" in
  "")
    if [[ ! -t 0 || ! -t 1 ]]; then
      usage
      exit 0
    fi
    py_bin="$(detect_python)" || exit $?
    menu_script="${REPO_ROOT}/scripts/mesh_menu_cli.py"
    if [[ ! -f "$menu_script" ]]; then
      echo "Error: missing menu CLI script at $menu_script" >&2
      exit 1
    fi
    menu_output="$(mktemp "${TMPDIR:-/tmp}/mesh-menu.XXXXXX.json")"
    trap 'rm -f "${menu_output:-}"' EXIT
    run_with_optional_questionary "$py_bin" "$menu_script" --output "$menu_output" || exit $?
    menu_json="$(cat "$menu_output")"
    menu_cmdline="$(MESH_MENU_JSON="$menu_json" "$py_bin" - <<'PY'
import json
import os
import shlex

payload = json.loads(os.environ["MESH_MENU_JSON"])
argv = payload.get("argv") or []
print(" ".join(shlex.quote(str(arg)) for arg in argv))
PY
)" || exit $?
    if [[ -z "$menu_cmdline" ]]; then
      exit 0
    fi
    rm -f "$menu_output"
    trap - EXIT
    eval "set -- $menu_cmdline"
    exec "$0" "$@"
    ;;
  status)
    ensure_router_env
    ensure_mac_router_tunnel
    run_meshctl status
    ;;
  thread)
    ensure_router_env
    ensure_mac_router_tunnel
    thread_name="${2:-}"
    if [[ -z "$thread_name" ]]; then
      resolve_current_repo_context
      repo_path="$CURRENT_REPO_PATH"
      repo="$CURRENT_REPO_NAME"
      thread_name="$(latest_thread_for_repo "$repo" "$repo_path" || true)"
      if [[ -z "$thread_name" ]]; then
        echo "Error: no thread provided and no recent thread found on router for repo '$repo'." >&2
        echo "Use: mesh start \"<feature>\" or mesh thread <thread-name>" >&2
        exit 1
      fi
    fi
    run_meshctl thread status "$thread_name"
    ;;
  live)
    shift
    case "${1:-}" in
      ""|-h|--help)
        live_usage
        exit 0
        ;;
    esac
    py_bin="$(detect_python)" || exit $?
    live_script="${REPO_ROOT}/scripts/mesh_live_cli.py"
    if [[ ! -f "$live_script" ]]; then
      echo "Error: missing live CLI script at $live_script" >&2
      exit 1
    fi
    exec "$py_bin" "$live_script" "$@"
    ;;
  sessions)
    ensure_router_env
    ensure_mac_router_tunnel
    py_bin="$(detect_python)" || exit $?
    session_args=("${@:2}")
    if [[ ${#session_args[@]} -gt 0 && ( "${session_args[0]}" == "-h" || "${session_args[0]}" == "--help" ) ]]; then
      session_usage
      exit 0
    fi
    if [[ ${#session_args[@]} -gt 0 && "${session_args[0]}" == "--list" ]]; then
      session_args=("${session_args[@]:1}")
    elif [[ -t 0 && -t 1 ]]; then
      run_session_manage_flow "$py_bin" "" "${session_args[@]}"
    fi
    session_script="${REPO_ROOT}/scripts/mesh_session_cli.py"
    if [[ ! -f "$session_script" ]]; then
      echo "Error: missing session CLI script at $session_script" >&2
      exit 1
    fi
    exec "$py_bin" "$session_script" list "${session_args[@]}"
    ;;
  term)
    shift
    term_cmd="${1:-}"
    case "$term_cmd" in
      ""|-h|--help)
        term_usage
        exit 0
        ;;
      list)
        shift
        run_iterm_control list "$@"
        ;;
      focus)
        if [[ $# -lt 3 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        role="$2"
        shift 2
        run_iterm_control focus --repo "$repo" --role "$role" "$@"
        ;;
      send)
        if [[ $# -lt 4 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        role="$2"
        text="$3"
        shift 3
        run_iterm_control send-text --repo "$repo" --role "$role" "$text" "$@"
        ;;
      exec)
        if [[ $# -lt 4 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        role="$2"
        text="$3"
        shift 3
        run_iterm_control send-line --repo "$repo" --role "$role" "$text" "$@"
        ;;
      key)
        if [[ $# -lt 4 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        role="$2"
        key_name="$3"
        shift 3
        run_iterm_control send-key --repo "$repo" --role "$role" "$key_name" "$@"
        ;;
      dump)
        if [[ $# -lt 3 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        role="$2"
        shift 2
        run_iterm_control dump --repo "$repo" --role "$role" "$@"
        ;;
      close)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control close --repo "$repo" "$@"
        ;;
      two-cli-smoke)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control two-cli-smoke --repo "$repo" "$@"
        ;;
      two-cli-e2e)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control two-cli-e2e --repo "$repo" "$@"
        ;;
      team-e2e)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control team-e2e --repo "$repo" "$@"
        ;;
      speckit-team-e2e)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control speckit-team-e2e --repo "$repo" "$@"
        ;;
      speckit-team-run)
        if [[ $# -lt 2 ]]; then
          term_usage
          exit 2
        fi
        shift
        repo="$1"
        shift
        run_iterm_control speckit-team-run --repo "$repo" "$@"
        ;;
      *)
        echo "Error: unsupported term subcommand '$term_cmd'" >&2
        term_usage
        exit 2
        ;;
    esac
    ;;
  speckit)
    shift
    run_speckit_short "$@"
    ;;
  lite)
    shift
    lite_cmd="${1:-}"
    case "$lite_cmd" in
      ""|-h|--help)
        lite_usage
        exit 0
        ;;
      *)
        run_mesh_lite "$@"
        ;;
    esac
    ;;
  attach)
    ensure_router_env
    ensure_mac_router_tunnel
    py_bin="$(detect_python)" || exit $?
    run_session_manage_flow "$py_bin" "attach" "${@:2}"
    ;;
  send|enter|interrupt|summary)
    ensure_router_env
    ensure_mac_router_tunnel
    py_bin="$(detect_python)" || exit $?
    session_script="${REPO_ROOT}/scripts/mesh_session_cli.py"
    if [[ ! -f "$session_script" ]]; then
      echo "Error: missing session CLI script at $session_script" >&2
      exit 1
    fi
    exec "$py_bin" "$session_script" "$cmd" "${@:2}"
    ;;
  bootstrap)
    ws_host="${MESH_WS_HOST:-sam@10.0.0.2}"
    ws_env_dir="${MESH_WS_ENV_DIR:-/etc/mesh-worker}"
    stop_batch="${MESH_BOOTSTRAP_STOP_BATCH:-0}"
    bootstrap_script="$(cat <<'EOF'
set -euo pipefail

env_dir="${1:?missing env_dir}"
stop_batch="${2:-0}"
repo_root_hint="${3:-}"

resolve_repo_root() {
  local hint="${1:-}"
  local candidates=(
    "$hint"
    "/media/sam/1TB/gobabygo"
    "$HOME/gobabygo"
    "/opt/mesh-router"
    "/opt/mesh-worker"
  )
  local candidate
  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate/mapping/provider_runtime.yaml" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

repo_root="$(resolve_repo_root "$repo_root_hint" || true)"

set_kv() {
  local file="$1" key="$2" value="$3"
  local escaped
  escaped="$(printf '%s' "$value" | sed 's/[&|]/\\&/g')"
  if sudo grep -q "^${key}=" "$file"; then
    sudo sed -i "s|^${key}=.*|${key}=${escaped}|" "$file"
  else
    echo "${key}=${value}" | sudo tee -a "$file" >/dev/null
  fi
}

configure_session_worker_env() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    echo "[WARN] missing env file: $file"
    return 0
  fi
  set_kv "$file" MESH_CLI_COMMAND "ccs {target_account}"
  set_kv "$file" MESH_ALLOWED_ACCOUNTS "*"
  if command -v upterm >/dev/null 2>&1; then
    set_kv "$file" MESH_UPTERM_BIN "$(command -v upterm)"
  fi
  echo "[OK] configured $file"
}

session_cli_type_from_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk -F= '/^MESH_CLI_TYPE=/{print $2; exit}' "$file" | tr -d '"' | xargs
}

provider_identity_json() {
  local cli_type="$1"
  if [[ -z "$repo_root" ]]; then
    printf '{"user":"","group":"","supplementary_groups":[]}'
    return 0
  fi
  python3 - "$repo_root" "$cli_type" <<'PY'
import json
import sys

repo_root = sys.argv[1]
cli_type = sys.argv[2]
sys.path.insert(0, repo_root)

from src.router.provider_runtime import resolve_session_service_identity

print(json.dumps(resolve_session_service_identity(cli_type)))
PY
}

session_identity_field() {
  local cli_type="$1" field="$2"
  local payload
  payload="$(provider_identity_json "$cli_type")"
  MESH_PROVIDER_IDENTITY_JSON="$payload" python3 - "$field" <<'PY'
import json
import os
import sys

field = sys.argv[1]
data = json.loads(os.environ["MESH_PROVIDER_IDENTITY_JSON"])
value = data.get(field, [])
if isinstance(value, list):
    print(" ".join(str(item) for item in value if str(item).strip()))
else:
    print(str(value or "").strip())
PY
}

apply_session_service_override() {
  local unit_instance="$1" cli_type="$2"
  local user group supplementary_groups override_dir override_path

  user="$(session_identity_field "$cli_type" user)"
  group="$(session_identity_field "$cli_type" group)"
  supplementary_groups="$(session_identity_field "$cli_type" supplementary_groups)"
  [[ -n "$user" ]] || return 0

  override_dir="/etc/systemd/system/mesh-session-worker@${unit_instance}.service.d"
  override_path="${override_dir}/runtime-user.conf"

  sudo mkdir -p "$override_dir"
  {
    echo "[Service]"
    echo "User=${user}"
    echo "Group=${group:-$user}"
    echo "SupplementaryGroups="
    if [[ -n "$supplementary_groups" ]]; then
      echo "SupplementaryGroups=${supplementary_groups}"
    fi
    echo "Environment=HOME=/home/${user}"
  } | sudo tee "$override_path" >/dev/null
  echo "[OK] applied ${cli_type} session user override: user=${user} group=${group:-$user} supplementary_groups=${supplementary_groups:-<none>}"
}

apply_session_service_override_for_env() {
  local file="$1"
  local cli_type unit_instance

  [[ -f "$file" ]] || return 0
  cli_type="$(session_cli_type_from_env_file "$file")"
  if [[ -z "$cli_type" ]]; then
    echo "[WARN] could not determine MESH_CLI_TYPE for $file"
    return 0
  fi
  unit_instance="$(basename "$file" .env)"
  apply_session_service_override "$unit_instance" "$cli_type"
}

bootstrap_mesh_worker_runtime() {
  local task_group="mesh-worker"

  if getent group sam >/dev/null 2>&1; then
    task_group="sam"
  fi

  sudo mkdir -p /home/mesh-worker/.ccs/instances
  sudo mkdir -p /home/mesh-worker/.claude
  sudo mkdir -p /tmp/mesh-tasks
  sudo mkdir -p /etc/tmpfiles.d
  cat <<TMPFILES | sudo tee /etc/tmpfiles.d/mesh-worker.conf >/dev/null
d /tmp/mesh-tasks 2775 mesh-worker ${task_group} -
TMPFILES
  sudo chmod 644 /etc/tmpfiles.d/mesh-worker.conf
  sudo systemd-tmpfiles --create /etc/tmpfiles.d/mesh-worker.conf
  sudo chown -R mesh-worker:mesh /home/mesh-worker/.ccs /home/mesh-worker/.claude
  if getent group sam >/dev/null 2>&1; then
    sudo chown -R mesh-worker:sam /tmp/mesh-tasks
  else
    sudo chown -R mesh-worker:mesh-worker /tmp/mesh-tasks
    echo "[WARN] group 'sam' missing; /tmp/mesh-tasks kept on mesh-worker:mesh-worker"
  fi
  sudo chmod 2775 /tmp/mesh-tasks
  sudo find /tmp/mesh-tasks -type d -exec chmod 2775 {} +
  sudo find /tmp/mesh-tasks -type f -exec chmod ug+rw {} +

  if ! sudo -u mesh-worker env PATH=/usr/local/bin:/usr/bin:/bin bash -lc 'command -v ccs >/dev/null 2>&1' \
    && [[ -x /home/sam/.npm-global/bin/ccs ]]; then
    sudo ln -sf /home/sam/.npm-global/bin/ccs /usr/local/bin/ccs
    echo "[OK] linked ccs into /usr/local/bin/ccs"
  fi

  if [[ -x /home/sam/.npm-global/bin/claude ]]; then
    sudo ln -sf /home/sam/.npm-global/bin/claude /usr/local/bin/claude
    echo "[OK] linked claude into /usr/local/bin/claude"
  fi
}

bootstrap_mesh_worker_runtime
for env_file in "${env_dir}"/mesh-session-*.env; do
  [[ -f "$env_file" ]] || continue
  configure_session_worker_env "$env_file"
  apply_session_service_override_for_env "$env_file"
done

sudo systemctl daemon-reload
for env_file in "${env_dir}"/mesh-session-*.env; do
  [[ -f "$env_file" ]] || continue
  name="$(basename "$env_file" .env)"
  sudo systemctl restart "mesh-session-worker@${name}"
done

if [[ "$stop_batch" == "1" ]]; then
  sudo systemctl stop mesh-worker@claude-work || true
  sudo systemctl stop mesh-worker@codex-work || true
  sudo systemctl stop mesh-worker@gemini-work || true
  echo "[OK] batch workers stopped"
fi

for env_file in "${env_dir}"/mesh-session-*.env; do
  [[ -f "$env_file" ]] || continue
  name="$(basename "$env_file" .env)"
  if sudo systemctl is-active --quiet "mesh-session-worker@${name}"; then
    echo "[OK] session ${name} active"
  fi
done

echo
echo "Bootstrap complete."
if [[ -n "$repo_root" ]]; then
  echo "Provider runtime policy: ${repo_root}/mapping/provider_runtime.yaml"
  echo "Account pool policy: ${repo_root}/mapping/account_pools.yaml"
fi
echo "Session workers now preseed Claude project state on task start (.claude.json trust/onboarding/MCP metadata)."
echo "mesh-worker runtime ownership for ~/.ccs and ~/.claude has been normalized."
if command -v upterm >/dev/null 2>&1; then
  echo "upterm detected: $(command -v upterm)"
else
  echo "[WARN] upterm not installed on WS; attach handles will fallback to ssh/tmux only"
fi
echo "Next:"
echo "  1) create isolated Claude CCS account profiles once (if missing):"
echo "     ccs auth create claude-<account>"
echo "     edit mapping/account_pools.yaml to set the default Claude profile"
echo "  2) run from repo dir:"
echo "     mesh run <phase>"
EOF
)"
    if is_local_host "$ws_host"; then
      bash -s -- "$ws_env_dir" "$stop_batch" "$REPO_ROOT" <<<"$bootstrap_script"
    else
      ssh -tt -o ConnectTimeout=10 "$ws_host" "bash -s" -- "$ws_env_dir" "$stop_batch" "$REPO_ROOT" <<<"$bootstrap_script"
    fi
    ;;
  ui)
    ui_args=("${@:2}")
    if [[ ${#ui_args[@]} -gt 0 && ( "${ui_args[0]}" == "-h" || "${ui_args[0]}" == "--help" ) ]]; then
      ui_usage
      exit 0
    fi
    if [[ ${#ui_args[@]} -gt 0 ]]; then
      case "${ui_args[0]}" in
        attach|resume)
          if [[ ${#ui_args[@]} -gt 1 && ( "${ui_args[1]}" == "-h" || "${ui_args[1]}" == "--help" ) ]]; then
            ui_usage
            exit 0
          fi
          ui_args=("${ui_args[@]:1}")
          ui_args+=("--resume")
          ;;
      esac
    fi
    if [[ ${#ui_args[@]} -gt 0 && "${ui_args[0]}" == "close" ]]; then
      if [[ ${#ui_args[@]} -gt 1 && ( "${ui_args[1]}" == "-h" || "${ui_args[1]}" == "--help" ) ]]; then
        ui_usage
        exit 0
      fi
      close_args=("${ui_args[@]:1}")
      normalized_close_args=()
      skip_next=0
      repo_normalized=0
      for arg in "${close_args[@]}"; do
        if [[ "$skip_next" == "1" ]]; then
          normalized_close_args+=("$arg")
          skip_next=0
          continue
        fi
        case "$arg" in
          --ui-group-id|--output)
            normalized_close_args+=("$arg")
            skip_next=1
            continue
            ;;
        esac
        if [[ "$repo_normalized" == "0" && "$arg" != -* ]]; then
          resolve_repo_hint_for_close "$arg"
          normalized_close_args+=("$RESOLVED_REPO_PATH")
          repo_normalized=1
          continue
        fi
        normalized_close_args+=("$arg")
      done
      py_bin="$(detect_python)" || exit $?
      ensure_router_env
      ensure_mac_router_tunnel
      session_script="${REPO_ROOT}/scripts/mesh_session_cli.py"
      if [[ ! -f "$session_script" ]]; then
        echo "Error: missing session CLI script at $session_script" >&2
        exit 1
      fi
      exec "$py_bin" "$session_script" close "${normalized_close_args[@]}"
    fi
    if [[ ${#ui_args[@]} -eq 0 ]]; then
      resolve_current_repo_context
      if [[ "$CURRENT_REPO_PATH" == "$REPO_ROOT" ]]; then
        echo "Error: running 'mesh ui' from the control repo requires an explicit target repo." >&2
        echo "Use: ./scripts/mesh ui snake-game" >&2
        echo "Or:  ./scripts/mesh ui /media/sam/1TB/snake-game" >&2
        exit 2
      fi
      ui_args=("$CURRENT_REPO_PATH")
    fi
    if [[ "$(uname -s)" != "Darwin" ]]; then
      if [[ -n "${MESH_UI_FORWARD_HOST:-}" ]]; then
        forward_args=("${ui_args[@]}")
        # Normalize first positional argument (repo) to absolute WS path before forwarding.
        if [[ "${forward_args[0]}" != -* ]]; then
          resolve_repo_path_and_name "${forward_args[0]}"
          forward_args[0]="$RESOLVED_REPO_PATH"
        fi
        escaped_args=""
        for arg in "${forward_args[@]}"; do
          escaped_args+=" $(printf '%q' "$arg")"
        done
        exec ssh -tt "$MESH_UI_FORWARD_HOST" "cd '$MESH_UI_FORWARD_REPO' && MESH_WS_REPO_BASE='${WS_REPO_BASE}' ./scripts/mesh ui${escaped_args}"
      fi
      echo "Error: mesh ui is available only on macOS/iTerm2." >&2
      echo "Set MESH_UI_FORWARD_HOST to auto-forward this command to your Mac operator host." >&2
      exit 2
    fi

    py_bin="$(detect_python)" || exit $?
    ensure_router_env
    ensure_mac_router_tunnel
    ui_script="${REPO_ROOT}/scripts/mesh_iterm_ui.py"
    if [[ ! -f "$ui_script" ]]; then
      echo "Error: missing iTerm UI script at $ui_script" >&2
      exit 1
    fi
    if ! python_has_module "$py_bin" iterm2; then
      if uv_bin="$(detect_uv)"; then
        exec "$uv_bin" run --with iterm2 -- python "$ui_script" "${ui_args[@]}"
      fi
      echo "Error: Python package 'iterm2' not found. Install with: uv run --with iterm2 -- python scripts/mesh_iterm_ui.py ..." >&2
      exit 3
    fi
    exec "$py_bin" "$ui_script" "${ui_args[@]}"
    ;;
  deploy)
    ws_host="${MESH_WS_HOST:-sam@10.0.0.2}"
    ws_repo_dir="${MESH_WS_REPO_DIR:-/opt/mesh-router}"
    caller_repo_root="${REPO_ROOT}"
    branch="${MESH_DEPLOY_BRANCH:-master}"
    restart_router="${MESH_DEPLOY_RESTART_ROUTER:-1}"
    restart_batch="${MESH_DEPLOY_RESTART_BATCH:-0}"
    restart_session="${MESH_DEPLOY_RESTART_SESSION:-1}"
    deploy_mode="${MESH_DEPLOY_MODE:-auto}" # auto|remote|local
    deploy_script="$(cat <<'EOF'
set -euo pipefail

repo_dir="${1:?missing repo_dir}"
branch="${2:-master}"
restart_router="${3:-1}"
restart_batch="${4:-0}"
restart_session="${5:-1}"
caller_repo_root="${6:-}"

resolve_repo_dir() {
  local preferred="$1" caller="$2"
  local candidates=(
    "$preferred"
    "$caller"
    "/opt/mesh-router"
    "$HOME/gobabygo"
    "/media/sam/1TB/gobabygo"
  )
  local d
  for d in "${candidates[@]}"; do
    if [[ -d "$d/.git" ]]; then
      printf '%s' "$d"
      return 0
    fi
  done
  return 1
}

resolved_repo="$(resolve_repo_dir "$repo_dir" "$caller_repo_root" || true)"
if [[ -z "$resolved_repo" ]]; then
  echo "Error: repo not found. tried: $repo_dir, $caller_repo_root, /opt/mesh-router, $HOME/gobabygo, /media/sam/1TB/gobabygo"
  exit 2
fi
repo_dir="$resolved_repo"

echo "[deploy] repo=$repo_dir branch=$branch"
cd "$repo_dir"
git fetch origin "$branch"
git pull --ff-only origin "$branch"

if [[ -x "$repo_dir/venv/bin/pip" ]]; then
  "$repo_dir/venv/bin/pip" install -e "$repo_dir" >/dev/null
  echo "[deploy] python deps synced"
fi

has_mesh_tmux=0
if command -v tmux >/dev/null 2>&1; then
  if tmux list-sessions 2>/dev/null | grep -q '^mesh-'; then
    has_mesh_tmux=1
  fi
fi

docker_router_running=0
if command -v docker >/dev/null 2>&1; then
  if docker inspect -f '{{.State.Running}}' mesh-router 2>/dev/null | grep -qx 'true'; then
    docker_router_running=1
  fi
fi

systemd_router_installed=0
systemd_router_active=0
if command -v systemctl >/dev/null 2>&1; then
  if systemctl list-unit-files 2>/dev/null | grep -q '^mesh-router\.service'; then
    systemd_router_installed=1
    if sudo systemctl is-active --quiet mesh-router; then
      systemd_router_active=1
    fi
  fi
fi

if [[ "$docker_router_running" == "1" && "$systemd_router_active" == "1" ]]; then
  echo "[deploy] ERROR: both Docker mesh-router and mesh-router.service are active"
  echo "[deploy] choose one router supervisor before deploying"
  exit 1
fi

if [[ "$restart_router" == "1" ]]; then
  if [[ "$docker_router_running" == "1" ]]; then
    echo "[deploy] router is managed by Docker (container mesh-router running); skipping systemd restart"
    echo "[deploy] use ./deploy/live-compose.sh restart on the router host"
  elif [[ "$systemd_router_installed" == "1" ]]; then
    sudo systemctl restart mesh-router
    sudo systemctl is-active --quiet mesh-router && echo "[deploy] mesh-router active"
  else
    echo "[deploy] mesh-router.service not found on this host; skipping router restart"
  fi
fi

if [[ "$restart_batch" == "1" ]]; then
  if systemctl list-unit-files 2>/dev/null | grep -q '^mesh-worker@\.service'; then
    sudo systemctl restart mesh-worker@claude-work || true
    sudo systemctl restart mesh-worker@codex-work || true
    sudo systemctl restart mesh-worker@gemini-work || true
  else
    echo "[deploy] mesh-worker@.service not found; skipping batch restart"
  fi
  echo "[deploy] batch workers restarted"
fi

if [[ "$restart_session" == "1" ]]; then
  if [[ "$has_mesh_tmux" == "1" ]]; then
    echo "[deploy] session workers NOT restarted (active/stale mesh tmux sessions detected)"
  else
    if systemctl list-unit-files 2>/dev/null | grep -q '^mesh-session-worker@\.service'; then
      sudo systemctl restart mesh-session-worker@mesh-session-claude-work
      sudo systemctl restart mesh-session-worker@mesh-session-codex-work
      echo "[deploy] session workers restarted"
    else
      echo "[deploy] mesh-session-worker@.service not found; skipping session restart"
    fi
  fi
fi

echo "[deploy] done"
EOF
)"

    run_local_deploy() {
      bash -s -- "$ws_repo_dir" "$branch" "$restart_router" "$restart_batch" "$restart_session" "$caller_repo_root" <<<"$deploy_script"
    }

    run_remote_deploy() {
      ssh -tt -o ConnectTimeout=10 "$ws_host" "bash -s" -- \
        "$ws_repo_dir" "$branch" "$restart_router" "$restart_batch" "$restart_session" "$caller_repo_root" <<<"$deploy_script"
    }

    case "$deploy_mode" in
      local)
        run_local_deploy
        ;;
      remote)
        run_remote_deploy
        ;;
      auto)
        if command -v systemctl >/dev/null 2>&1 && [[ -d /etc/mesh-worker ]]; then
          run_local_deploy
        else
          run_remote_deploy || {
            echo "Error: remote deploy failed. Set MESH_WS_HOST correctly (current: $ws_host)." >&2
            exit 1
          }
        fi
        ;;
      *)
        echo "Error: invalid MESH_DEPLOY_MODE='$deploy_mode' (use auto|remote|local)" >&2
        exit 1
        ;;
    esac
    ;;
  start|new)
    feature="${*:2}"
    if [[ -z "$feature" ]]; then
      feature="$(gen_feature_label)"
    fi

    resolve_current_repo_context
    repo_path="$CURRENT_REPO_PATH"
    repo="$CURRENT_REPO_NAME"
    build_pipeline_account_args "$repo"
    feature_slug="$(slugify "$feature")"
    ts="$(date +%Y%m%d-%H%M%S)"
    thread_name="${repo}-${feature_slug}-${ts}"

    run_meshctl pipeline create \
      --template "$PIPELINE_TEMPLATE" \
      --thread-name "$thread_name" \
      --repo "$repo_path" \
      --project "$repo" \
      --feature "$feature" \
      --phase "" \
      "${PIPELINE_ACCOUNT_ARGS[@]}"
    echo "Started thread: $thread_name"
    ;;
  run)
    input_a="${2:-}"
    input_b="${3:-}"

    # Dynamic mode: mesh run <phase>
    # Uses current directory as target repo.
    if [[ -n "$input_a" && -z "$input_b" ]]; then
      phase="$input_a"
      resolve_current_repo_context
      repo_path="$CURRENT_REPO_PATH"
      repo="$CURRENT_REPO_NAME"
    # Explicit mode: mesh run <repo-name|repo-path> <phase>
    elif [[ -n "$input_a" && -n "$input_b" ]]; then
      resolve_repo_path_and_name "$input_a"
      repo_path="$RESOLVED_REPO_PATH"
      repo="$RESOLVED_REPO_NAME"
      phase="$input_b"
    else
      usage
      exit 1
    fi
    build_pipeline_account_args "$repo"

    thread_name="${repo}-spec-${phase}"
    feature="spec-${phase}"
    run_meshctl pipeline create \
      --template "$PIPELINE_TEMPLATE" \
      --thread-name "$thread_name" \
      --repo "$repo_path" \
      --project "$repo" \
      --feature "$feature" \
      --phase "$phase" \
      "${PIPELINE_ACCOUNT_ARGS[@]}"
    echo "Started thread: $thread_name"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
