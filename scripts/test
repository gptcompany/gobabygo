#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if ! command -v uv >/dev/null 2>&1; then
  echo "Error: uv is required to run the reproducible test environment." >&2
  exit 127
fi

uv sync --frozen --python 3.11 --extra dev
exec uv run --frozen --python 3.11 --extra dev python -m pytest "$@"
