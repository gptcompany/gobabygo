#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

uv_bin="${UV_BIN:-}"
if [[ -z "$uv_bin" ]]; then
  uv_bin="$(command -v uv 2>/dev/null || true)"
fi
if [[ -z "$uv_bin" && -x "$HOME/.local/bin/uv" ]]; then
  uv_bin="$HOME/.local/bin/uv"
fi
if [[ -z "$uv_bin" || ! -x "$uv_bin" ]]; then
  echo "Error: uv is required to run the reproducible test environment." >&2
  exit 127
fi

"$uv_bin" sync --frozen --python 3.11 --extra dev
exec "$uv_bin" run --frozen --python 3.11 --extra dev python -m pytest "$@"
